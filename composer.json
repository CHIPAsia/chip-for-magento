{
    "name": "chipasia/chip-payment-gateway",
    "description": "CHIP payment gateway for Magento 2 (2.0 - 2.4)",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": ["OSL-3.0"],
    "keywords": ["magento", "magento2", "payment", "gateway", "chip", "fpx", "duitnow"],
    "require": {
        "php": "~7.0.0|~7.1.0|~7.2.0|~7.3.0|~7.4.0|~8.0.0|~8.1.0|~8.2.0|~8.3.0|~8.4.0",
        "magento/framework": ">=100.0.0",
        "magento/module-payment": ">=100.0.0",
        "magento/module-checkout": ">=100.0.0",
        "magento/module-sales": ">=100.0.0",
        "magento/module-config": ">=100.0.0",
        "magento/module-store": ">=100.0.0"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "CHIPAsia\\ChipPaymentGateway\\": ""
        }
    },
    "extra": {
        "map": [
            ["*", "CHIPAsia/ChipPaymentGateway"]
        ]
    }
}
